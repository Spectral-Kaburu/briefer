# briefing configuration example.
#
# Copy to ~/.config/briefing/briefing.yaml and edit. Every value below is a
# default, so you can delete any line you don't need to change.
#
# `briefing config` shows the effective config and where it lives.

# Topics used by `briefing run` (briefing mode). Research mode ignores these.
news_topics: ["technology", "world news", "Breaking news", "Formula 1 news"]

search:
  # How many results to aim for per query.
  results: 10
  # DDG region code. Passed straight through to ddgs; ddgs does not validate it
  # (NOTES-APIS section 4), so a typo is silent. Common: us-en, uk-en, ru-ru.
  # Change this if your results are off-region — but note the T8.4 probe found
  # region made no measurable difference to which country's outlets come back.
  region: us-en
  # Words like "latest/breaking/today/news" switch DDG to news search.
  auto_news_detect: true

firecrawl:
  local:
    # Self-hosted Firecrawl. Start it with: docker compose up -d
    base_url: http://localhost:3002
    timeout_s: 30
    concurrency: 5
  api:
    # Cloud API, used only when local extraction genuinely fails (SPEC section 4).
    base_url: https://api.firecrawl.dev
    # Name of the env var holding the key. The key itself is NEVER stored here.
    key_env: FIRECRAWL_API_KEY
    # Hard cap on API calls per day; at the cap, fetches degrade to snippet-only.
    daily_limit: 20
    # Seconds before an API call is abandoned.
    timeout_s: 30

whitelist:
  # Auto-whitelist a domain when local extraction hit a barrier (captcha, 403,
  # 429, empty content). Dead links and unsolvable errors never get whitelisted.
  auto_add: true
  path: whitelist.yaml
  # When true, whitelisted domains skip local and go straight to the API.
  prefer_api_for_whitelisted: false

summary:
  # extractive (offline, instant). The card text is always extractive; a model
  # answer is generated on top of it whenever an API key is configured.
  mode: extractive
  sentences: 2

# Briefing mode only: never brief on these topics.
blocklist_topics: [crypto, bitcoin, trading, forex, stocks]

dedup:
  # Forget a headline hash after this many days.
  headline_ttl_days: 7
  # Don't re-fire the same schedule_id within this window.
  schedule_window_hours: 24

# Timing bounds (SPEC section 4). Raise them on a slow link, lower them to fail
# fast; both are only defaults, so delete what you don't need to change.
timeouts:
  # Bound on one URL's fetch. It wraps the local scrape AND the API retry that
  # follows it, so 30s can cancel a paid API call mid-flight; 75 is the safer
  # value when an API key is configured. 0 means "no bound".
  per_url_s: 30
  # Pause before the one local retry SPEC allows for a transient 5xx.
  transient_backoff_s: 0.5

# Briefing mode: who the spoken briefing is from, and who it addresses.
briefing:
  # Who the briefing speaks to. Empty by default, which makes a run that cannot
  # be synthesised say "Good morning." and nothing more; set a name here and it
  # says "Good morning, <name>." instead. The assistant's own name never fills
  # this, so a degraded briefing never greets itself.
  user_name: ""
  # Who the briefing is from, used by the synthesis prompt only.
  name: Aether
  # Preferred LLM provider when both have valid keys (gemini, openai, or empty for auto).
  # When both keys are present, this determines which provider to use.
  # Empty means OpenAI is preferred (the default behavior). Set to "gemini" to prefer it.
  preferred_provider: ""
  # Gemini LLM settings: used by ask and research whenever a key is present.
  gemini:
    # Environment variable holding the Gemini API key.
    api_key_env: GEMINI_API_KEY
    # The model to use for generation.
    model: gemini-2.5-flash
  # OpenAI-compatible LLM settings (OpenAI, NVIDIA NIM, etc.).
  # The first configured provider with a valid API key will be used automatically.
  openai:
    # Base URL for the API endpoint (default: OpenAI).
    # Set to NVIDIA endpoint (https://integrate.api.nvidia.com/v1) for NVIDIA models.
    base_url: https://api.openai.com/v1
    # Environment variable holding the API key.
    api_key_env: OPENAI_API_KEY
    # The model to use for generation.
    model: gpt-4o-mini

# Ask mode configuration: shared by `briefing ask` and `briefing research`,
# which are one engine with two profiles.
ask:
  # Maximum search results to consider for fetching.
  results: 6
  # Maximum pages to fetch and include in the answer.
  pages: 3
  # Soft deadline in seconds. Pages are read in parallel; when this passes and
  # pages are still loading, a provisional answer is shown and the slow pages
  # keep loading — never dropped. 0 waits for everything before answering.
  deadline_s: 10
  # The most characters of one page sent to the model. Pages are sent whole;
  # this is a safety valve for the rare enormous one, and anything it cuts is
  # reported in the answer's notices rather than dropped silently. 0 = no limit.
  max_source_chars: 100000
  # The most characters of all pages together sent to the model; pages share it
  # fairly, shortest first. 0 = no limit.
  max_total_chars: 300000

# Knowledge source adapters for ask mode (Phase 10):
# Wikipedia and Stack Exchange provide encyclopedic answers; DDG Instant Answer
# is disabled by default due to low reliability (see NOTES-APIS.md §5.4).
knowledge:
  enabled: true
  wikipedia: true
  stackexchange: true
  # DuckDuckGo Instant Answer: probed, not worth it (low hit rate).
  ddg_instant: false
  # Timeout for each adapter call.
  timeout_s: 5
  # Custom User-Agent (default: generic briefing/<version>).
  # Never include email or real name.
  user_agent: ""
  # Environment variable for Stack Exchange API key (optional, gives higher quota).
  stackexchange_key_env: STACKEXCHANGE_KEY
  # Quota floor: skip API calls when remaining at or below this value.
  quota_floor: 20
