      "Bash(which *)",
      "Bash(command -v *)",
      "Bash(echo *)",
      "Bash(date *)",
      "Bash(sleep *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(chmod +x *)",
      "Bash(test *)",
