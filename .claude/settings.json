      "Bash(git branch -D*)",
      "Bash(git config --global *)",
      "Bash(rm -*)",
      "Bash(rm * -*)",
      "Bash(rm /*)",
      "Bash(rm ~*)",
      "Bash(rm ..*)",
      "Bash(find * -delete*)",
      "Bash(find * -exec *)",
      "Bash(chmod 777*)",
      "Bash(chown *)",
      "Bash(dd *)",
      "Bash(mkfs*)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(ssh *)",
      "Bash(scp *)",
